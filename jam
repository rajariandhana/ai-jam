#!/usr/bin/env bash
#
# Start the AI JAM backend and frontend together, then open the app.
# Ctrl+C stops both. Only one instance may run at a time.
#
# Symlink this onto your PATH to run it from anywhere:
#   ln -s "$PWD/jam" ~/.local/bin/jam

set -euo pipefail
set -m

# Follow symlinks back to the real script so the repo root is found either way.
SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"

  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$LINK_DIR/$SOURCE" ;;
  esac
done

ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$ROOT"

WEB_PORT="${WEB_PORT:-41743}"

# Keep the API port in step with whatever the frontend is told to call.
API_PORT="${API_PORT:-$(
  sed -n 's|^VITE_API_URL=.*://[^:/]*:\([0-9]*\).*|\1|p' .env 2>/dev/null | head -1
)}"
API_PORT="${API_PORT:-41744}"

LOCK_FILE="${TMPDIR:-/tmp}/ai-jam.pid"

API_PID=""
WEB_PID=""

lock_owner() {
  cat "$LOCK_FILE" 2>/dev/null || true
}

# Create the lock without clobbering, so two jams racing cannot both win.
write_lock() {
  (set -o noclobber; printf '%s\n' "$$" >"$LOCK_FILE") 2>/dev/null
}

acquire_lock() {
  if write_lock; then
    return 0
  fi

  local owner
  owner="$(lock_owner)"

  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
    return 1
  fi

  # Stale lock from a run that was killed before it could clean up.
  rm -f "$LOCK_FILE"
  write_lock
}

release_lock() {
  if [ "$(lock_owner)" = "$$" ]; then
    rm -f "$LOCK_FILE"
  fi
}

stop() {
  trap - INT TERM EXIT

  if [ -n "$API_PID" ] || [ -n "$WEB_PID" ]; then
    echo ""
    echo "Stopping..."

    for pid in "$API_PID" "$WEB_PID"; do
      [ -n "$pid" ] || continue

      # Each server runs in its own process group, so take the group with it.
      kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    done

    wait 2>/dev/null || true
  fi

  release_lock
}

# Wait for a port to accept connections, giving up after ~30s.
wait_for_port() {
  local port="$1" name="$2"

  for _ in $(seq 1 60); do
    if nc -z localhost "$port" 2>/dev/null; then
      return 0
    fi

    sleep 0.5
  done

  echo "error: $name did not come up on port $port" >&2
  return 1
}

# Refuse to start on an occupied port rather than letting a server drift
# onto a different one and collide with the other half of the app.
require_port_free() {
  local port="$1" name="$2" holder

  if ! nc -z localhost "$port" 2>/dev/null; then
    return 0
  fi

  holder="$(
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null |
      awk 'NR == 2 { print $1 " (pid " $2 ")" }'
  )"

  echo "error: port $port is in use${holder:+ by $holder}, needed for the $name." >&2
  echo "Free that port, then run jam again." >&2
  return 1
}

open_browser() {
  local url="$1"

  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  else
    echo "Open $url in your browser."
  fi
}

if ! acquire_lock; then
  owner="$(lock_owner)"

  echo "jam is already running (pid $owner)."
  echo "  Frontend http://localhost:$WEB_PORT"
  echo "  API      http://localhost:$API_PORT"
  echo ""
  echo "Opening the running app. To restart it, press Ctrl+C in its terminal"
  echo "(or run: kill $owner) and start jam again."

  open_browser "http://localhost:$WEB_PORT"
  exit 0
fi

trap stop INT TERM EXIT

require_port_free "$API_PORT" "backend"
require_port_free "$WEB_PORT" "frontend"

# Prefer the virtualenv when it can serve, otherwise fall back to uvicorn on PATH.
if [ -x "$ROOT/.venv/bin/python" ] &&
  "$ROOT/.venv/bin/python" -c "import uvicorn" >/dev/null 2>&1; then
  api_runner=("$ROOT/.venv/bin/python" -m uvicorn)
elif command -v uvicorn >/dev/null 2>&1; then
  api_runner=(uvicorn)
else
  echo "error: no uvicorn found. Install it with: .venv/bin/pip install uvicorn" >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "Installing frontend dependencies..."
  bun install
fi

echo "API      http://localhost:$API_PORT"
echo "Frontend http://localhost:$WEB_PORT"
echo ""

(cd cover_letter && exec "${api_runner[@]}" app:app --port "$API_PORT" --reload) &
API_PID=$!

bun run dev --port "$WEB_PORT" &
WEB_PID=$!

wait_for_port "$API_PORT" "backend"
wait_for_port "$WEB_PORT" "frontend"

open_browser "http://localhost:$WEB_PORT"

wait
